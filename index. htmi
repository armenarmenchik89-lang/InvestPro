
<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>InvestPro</title>
<style>
*{box-sizing:border-box}
body{margin:0;background:#101827;color:#fff;font-family:Arial,sans-serif}
header{padding:20px;background:#172235;display:flex;justify-content:space-between;align-items:center}
.logo{font-size:24px;font-weight:bold;color:#42d392}
.container{max-width:1100px;margin:auto;padding:20px}
.card{background:#1b283b;padding:20px;border-radius:15px;margin-bottom:18px;border:1px solid #29384e}
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:15px}
h2,h3{margin-top:0}
.value{font-size:28px;font-weight:bold;margin-top:10px}
.green{color:#42d392}
button{background:#42d392;color:#102030;border:0;padding:12px 18px;border-radius:8px;font-weight:bold}
nav{display:flex;gap:12px;flex-wrap:wrap}
small{color:#a9b7ca}
table{width:100%;border-collapse:collapse}
td,th{padding:12px;border-bottom:1px solid #34445a;text-align:left}
footer{text-align:center;padding:25px;color:#a9b7ca}
</style>
</head>
<body>

<header>
<div class="logo">InvestPro</div>
<nav>
<button onclick="showDashboard()">Dashboard</button>
<button onclick="showHistory()">История</button>
</nav>
</header>

<div class="container" id="content">

<h2>Панель инвестора</h2>
<p><small>Демонстрационная версия</small></p>

<div class="grid">
<div class="card">
<h3>Баланс</h3>
<div class="value">$10,000.00</div>
</div>

<div class="card">
<h3>Инвестиции</h3>
<div class="value">$5,000.00</div>
</div>

<div class="card">
<h3>Прибыль</h3>
<div class="value green">$250.00</div>
</div>
</div>

<div class="card">
<h2>Инвестиционный портфель</h2>
<table>
<tr><th>Актив</th><th>Сумма</th><th>Статус</th></tr>
<tr><td>Stocks</td><td>$2,000</td><td class="green">Demo</td></tr>
<tr><td>Bonds</td><td>$1,500</td><td class="green">Demo</td></tr>
<tr><td>ETF</td><td>$1,500</td><td class="green">Demo</td></tr>
</table>
</div>

<div class="card">
<h2>Последние операции</h2>
<table>
<tr><th>Операция</th><th>Сумма</th><th>Дата</th></tr>
<tr><td>Инвестиция</td><td>$1,000</td><td>24.11.2026</td></tr>
<tr><td>Демо прибыль</td><td>$50</td><td>24.11.2026</td></tr>
</table>
</div>

<div class="card">
<h2>InvestPro</h2>
<p>Демонстрационная инвестиционная панель.</p>
<small>Данные являются демонстрационными. Этот сайт не принимает деньги и не совершает реальные инвестиции.</small>
</div>

</div>

<footer>InvestPro &copy; 2026 — Demo</footer>

<script>
function showDashboard(){
document.getElementById('content').innerHTML =
'<h2>Панель инвестора</h2><div class="card"><h3>Баланс</h3><div class="value">$10,000.00</div><p>Демонстрационный баланс</p></div><div class="card"><h3>Портфель</h3><p>Stocks — $2,000</p><p>Bonds — $1,500</p><p>ETF — $1,500</p></div>';
}
function showHistory(){
document.getElementById('content').innerHTML =
'<h2>История операций</h2><div class="card"><table><tr><th>Операция</th><th>Сумма</th></tr><tr><td>Демо инвестиция</td><td>$1,000</td></tr><tr><td>Демо прибыль</td><td>$50</td></tr></table></div>';
}
</script>

</body>
</html>
